{
  "_comment": "Runtime inventory (spec R4, R13). Install-AIMachine.ps1 copies exactly this into {ClaudeHome}. Paths are corpus-relative. Every skill/agent/command folder is included unless listed in exclude.",
  "version": 1,
  "runtime": [
    { "kind": "dir-each", "from": "skills", "to": "skills", "exclude": [ "myfable-foreman-prev-2026-09-13" ] },
    { "kind": "file-each", "from": "agents", "to": "agents", "filter": "*.md" },
    { "kind": "file-each", "from": "commands", "to": "commands", "filter": "*.md" },
    { "kind": "tree", "from": "claude/scripts", "to": "scripts" },
    { "kind": "tree", "from": "lib", "to": "lib" },
    { "kind": "file", "from": "claude/CLAUDE.md", "to": "CLAUDE.md" },
    { "kind": "file", "from": "claude/statusline.ps1", "to": "statusline.ps1" },
    { "kind": "file", "from": "setup/ai.ps1", "to": "bin/ai.ps1" },
    { "kind": "file", "from": "setup/Install-AIMachine.ps1", "to": "bin/Install-AIMachine.ps1" },
    { "kind": "file", "from": "setup/Test-NoHardPaths.ps1", "to": "bin/Test-NoHardPaths.ps1" },
    { "kind": "file", "from": "setup/Install-AIMcp.ps1", "to": "bin/Install-AIMcp.ps1" },
    { "kind": "file", "from": "setup/Export-AISecrets.ps1", "to": "bin/Export-AISecrets.ps1" },
    { "kind": "file", "from": "setup/Invoke-AIHarvest.ps1", "to": "bin/Invoke-AIHarvest.ps1" },
    { "kind": "file", "from": "setup/Show-AIMachine.ps1", "to": "bin/Show-AIMachine.ps1" },
    { "kind": "file", "from": "setup/Write-AIFile.ps1", "to": "bin/Write-AIFile.ps1" },
    { "kind": "file", "from": "setup/Publish-KitFile.ps1", "to": "bin/Publish-KitFile.ps1" },
    { "kind": "file", "from": "setup/Clear-AIScratch.ps1", "to": "bin/Clear-AIScratch.ps1" },
    { "kind": "tree", "from": "claude", "to": "machine-config/claude", "filter": "*.json;*.yaml" }
  ],
  "unmanaged": [ "skills/synced", "skills/.trash" ],
  "scopes": {
    "_comment": "Which machines get a skill/agent/command. Anything not listed is general (every machine). The machine profile's Role key picks: Role=personal skips work items; Role=work (or blank) skips personal items. Patterns are kind/name with -like wildcards. Topic categories (skill-taxonomy.ps1) are a separate axis.",
    "work": [
      "skills/testauto-*",
      "skills/crewchief-*",
      "skills/speedy-*",
      "skills/testdata-*",
      "skills/profisee-*",
      "skills/api-response-standardization",
      "skills/atomic-tests",
      "skills/bulk-custom-parms-editor-base",
      "skills/configuration-compression-codec",
      "skills/connex-import-tokenization",
      "skills/custom-parm-editor",
      "skills/inno-setup-installer",
      "skills/matching-api-status-poller",
      "skills/record-mapper-extension-methods",
      "skills/scenario-config-inspector",
      "skills/secrets-bootstrap-middleware",
      "skills/seq-query",
      "skills/skill-fix-integration-tests",
      "skills/skill-inspect-workflow",
      "skills/speedmerchants-db-migration",
      "skills/step-reference-resolution",
      "skills/utility-step-polymorphic-deserialization",
      "skills/dotnet-domain-values",
      "skills/dotnet-entity-constants",
      "skills/dotnet-logging-schema",
      "skills/dotnet-project-structure",
      "skills/dotnet-service-registration",
      "skills/dotnet-sql-data-access",
      "skills/dotnet-testing",
      "skills/external-json-case-insensitive-reads",
      "skills/result-pattern",
      "skills/blazor-code-behind",
      "skills/blazor-icons",
      "skills/blazor-click-path-audit",
      "skills/requirements-writing",
      "skills/skill-audit-with-update",
      "skills/skill-compare-performance-by-versions",
      "skills/ado-work-item-standards",
      "skills/bug-generator",
      "skills/task-generator",
      "skills/documentation-folder",
      "skills/documentation-location",
      "skills/elsa-feature-review",
      "skills/json-formatting-conventions",
      "skills/scorecard-wizard",
      "skills/machine-sync",
      "agents/config-validator.md",
      "agents/job-implementer.md",
      "agents/scenario-config-generator.md",
      "agents/scenario-custom-metric-coder.md",
      "agents/scenario-designer.md",
      "agents/testauto-reviewer.md"
    ],
    "personal": [ ]
  },
  "secretEnv": [
    "SEQ_API_KEY",
    "SM_SA_PASSWORD",
    "SM_SUT_APIKEY",
    "SM_SUT_URL",
    "SM_WORKLOAD_APIKEY",
    "SM_WORKLOAD_URL",
    "SPEEDY_CENTRAL_CONNECTION",
    "SPEEDY_CENTRAL_SETTINGS",
    "AZURE_DEVOPS_PAT"
  ],
  "psModules": [ "powershell-yaml" ]
}
