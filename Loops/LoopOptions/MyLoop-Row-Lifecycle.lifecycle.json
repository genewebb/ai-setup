{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "MyLoop Row Lifecycle",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-rail",
        "label": "Happy path",
        "focus": [
          "ready",
          "dispatched",
          "collected",
          "verdict",
          "closed"
        ],
        "note": "One attempt of a row: dispatched under a claim epoch, collected with a version compare, closed through a journalled two-phase close."
      },
      {
        "id": "attempt-endings",
        "label": "Attempt endings",
        "focus": [
          "dispatched",
          "lost",
          "collected",
          "rejected",
          "closed"
        ],
        "note": "A lost or rejected attempt re-enters the ReadySet; only Dispatch-Row starts the next attempt, with a new claim epoch."
      },
      {
        "id": "crash-repair",
        "label": "Crash repair",
        "focus": [
          "intent_only",
          "commit_no_entry",
          "torn_record",
          "ready",
          "dispatched"
        ],
        "note": "Reconcile-Rows -Repair reads the journal and moves every stranded shape to one legal state; a second run repairs nothing."
      }
    ]
  },
