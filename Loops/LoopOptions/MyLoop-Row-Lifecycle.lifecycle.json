  "cards": [
    {
      "dot": "cyan",
      "title": "One guard for every move",
      "items": [
        "Set-RowState looks (from, to, by) up in lib\\RowStates.ps1 and refuses anything the table does not name",
        "Write-Row compares the record's version: a stale writer gets STALE-WRITE, its bytes never land",
        "A collect, verdict or reject must state the current claim epoch; an old attempt's result is refused"
      ]
    },
    {
      "dot": "amber",
      "title": "Crash discipline",
      "items": [
        "Every dispatch and close writes an intent line to journal.jsonl before its first side effect and a committed line after its last",
        "The row record is the commit point; a crash before it rolls back, a crash after it completes forward",
        "Every state file is written temp, flush, rename; a torn file is quarantined, never parsed as truth"
      ]
    },
    {
      "dot": "rose",
      "title": "Who may move a row",
      "items": [
        "Dispatch-Row alone creates attempts, also from lost, rejected and closed",
        "Collect-Row alone moves to collected, records verdicts and rejects",
        "Close-Row closes; Reconcile-Rows completes a crashed close, marks lost and reconstructs; Approve-Gate only approves gate rows"
      ]
    }
  ]
}
